  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register  Create an account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "query": []
            },
            "description": "Public signup creates only student or faculty accounts. An admin promotes others.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"admin@campus-demo.test\",\n  \"password\": \"admin123\",\n  \"role\": \"student\",\n  \"department\": \"text\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) { pm.collectionVariables.set('token', body.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login  Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
