# Copy to .env (repo root) and to backend/.env if you run the backend from backend/.
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_events
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5433/campus_events
TEST_DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5433/campus_events_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173

# AI (Google AI Studio). Leave the key empty to run on the deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
VITE_INSTITUTION_NAME=Campus Events
VITE_INSTITUTION_LOGO=
